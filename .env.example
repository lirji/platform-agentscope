APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8085
APP_LOG_LEVEL=INFO

# AgentScope 2.0 继续经 LiteLLM 使用 OpenAI-compatible API。
GATEWAY_BASE_URL=http://localhost:4000/v1
GATEWAY_API_KEY=replace-with-local-litellm-key
GATEWAY_MODEL=chat-default
GATEWAY_TEMPERATURE=0.2
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=0
AGENT_TIMEOUT_SECONDS=0
AGENT_MAX_REPEATS=3
AGENT_LOOP_WINDOW=6
AGENT_RAG_TOP_K=5
AGENT_RAG_MIN_SCORE=0
AGENT_RAG_CATEGORY=
# 候选灰度入口默认关闭；仅在 edge/facade 路由演练时显式开启。
AGENT_V2_ENABLED=false

# 与 langchain4j-platform 的 platform-security 对齐。
INTERNAL_AUTH_REQUIRED=true
INTERNAL_JWT_HEADER=X-Internal-Token
INTERNAL_JWT_ALGORITHM=HS256
INTERNAL_JWT_SECRET=dev-only-internal-secret-change-me-please-32b
# RS256 验签时使用 PEM 内容或文件路径，二选一；HS256 时留空。
INTERNAL_JWT_PUBLIC_KEY=
INTERNAL_JWT_PUBLIC_KEY_FILE=

KNOWLEDGE_BASE_URL=http://localhost:8084
ANALYTICS_BASE_URL=http://localhost:8083
WORKFLOW_BASE_URL=http://localhost:8082
ORDER_BASE_URL=http://localhost:8093
HTTP_CONNECT_TIMEOUT_SECONDS=1
HTTP_READ_TIMEOUT_SECONDS=10

OTEL_ENABLED=false
OTEL_SERVICE_NAME=agentscope-orchestrator
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
