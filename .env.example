APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8085
APP_LOG_LEVEL=INFO

# AgentScope 2.0 继续经 LiteLLM 使用 OpenAI-compatible API。
GATEWAY_BASE_URL=http://localhost:4000/v1
GATEWAY_API_KEY=replace-with-local-litellm-key
GATEWAY_MODEL=chat-default
GATEWAY_TEMPERATURE=0.2
AGENT_MAX_STEPS=8
# 整次运行的总 token 预算和 wall-clock deadline；不支持 0（无限）。
AGENT_MAX_TOKENS=24000
AGENT_TIMEOUT_SECONDS=120
# 单次模型输出上限；provider retry/failover 由 LiteLLM 统一负责。
AGENT_MODEL_MAX_OUTPUT_TOKENS=4096
AGENT_MODEL_MAX_RETRIES=0
AGENT_MAX_REPEATS=3
AGENT_LOOP_WINDOW=6
AGENT_RAG_TOP_K=5
AGENT_RAG_MIN_SCORE=0
AGENT_RAG_CATEGORY=
# 候选灰度入口默认关闭；仅在 edge/facade 路由演练时显式开启。
AGENT_V2_ENABLED=false
# Phase 2 DAG 同步编排限制。
AGENT_DAG_MAX_TASKS=6
AGENT_DAG_MAX_PARALLEL_WORKERS=8
# 与旧服务部署默认一致；可作为独立回滚开关关闭。
AGENT_DAG_REPLAN_ENABLED=true
AGENT_DAG_REPLAN_MAX_REPLANS=1
AGENT_DAG_REPLAN_THRESHOLD=0.75
AGENT_DAG_REPLAN_WEIGHT_CORRECTNESS=0.5
AGENT_DAG_REPLAN_WEIGHT_COMPLETENESS=0.35
AGENT_DAG_REPLAN_WEIGHT_CLARITY=0.15
# Planner 使用确定性 JSON 输出；默认不自动重试，避免隐藏的模型调用放大。
AGENT_PLANNER_MAX_TOKENS=1200
AGENT_PLANNER_TIMEOUT_SECONDS=30
AGENT_PLANNER_MAX_RETRIES=0
AGENT_CHAINING_STEPS_JSON=[{"name":"translate","instruction":"把输入内容翻译成英文，只输出译文，不要额外解释","gateMinLength":10},{"name":"summarize","instruction":"用一句中文概括上一步英文内容的要点","gateMinLength":8}]
AGENT_VOTING_N=3
AGENT_VOTING_MAX_CANDIDATES=10
AGENT_VOTING_STRATEGY=majority
AGENT_VOTING_MIN_AGREEMENT=0.5
AGENT_SIBLING_MAX_PARALLEL_WORKERS=10
AGENT_REFLEXION_THRESHOLD=0.75
AGENT_REFLEXION_MAX_ATTEMPTS=2
AGENT_REFLEXION_WEIGHT_CORRECTNESS=0.4
AGENT_REFLEXION_WEIGHT_COMPLETENESS=0.4
AGENT_REFLEXION_WEIGHT_CLARITY=0.2
AGENT_SESSION_STORE=memory
AGENT_SESSION_REDIS_URL=
AGENT_SESSION_REDIS_NAMESPACE=agentscope:agent-session
AGENT_SESSION_TTL_SECONDS=86400
AGENT_SESSION_LEASE_SECONDS=180

# 与 langchain4j-platform 的 platform-security 对齐。
INTERNAL_AUTH_REQUIRED=true
INTERNAL_JWT_HEADER=X-Internal-Token
INTERNAL_JWT_ALGORITHM=HS256
INTERNAL_JWT_SECRET=dev-only-internal-secret-change-me-please-32b
INTERNAL_JWT_ISSUER=langchain4j-platform
INTERNAL_JWT_AUDIENCE=platform-internal
INTERNAL_JWT_KEY_ID=platform-internal-v1
INTERNAL_JWT_TOKEN_USE=internal_access
INTERNAL_JWT_CLOCK_SKEW_SECONDS=5
INTERNAL_JWT_MAX_TTL_SECONDS=300
# RS256 验签时使用 PEM 内容或文件路径，二选一；HS256 时留空。
INTERNAL_JWT_PUBLIC_KEY=
INTERNAL_JWT_PUBLIC_KEY_FILE=

KNOWLEDGE_BASE_URL=http://localhost:8084
ANALYTICS_BASE_URL=http://localhost:8083
# Slice 5：仅双跑候选 SQL planner；主响应仍来自 Java 旧 NL2SQL 路径。
ANALYTICS_EXTERNAL_PLANNER_SHADOW_ENABLED=false
ANALYTICS_EXTERNAL_PLANNER_MAX_TABLES=20
WORKFLOW_BASE_URL=http://localhost:8082
# 受治理写工具：默认关闭。开启后必须使用参数绑定的短时签名 grant。
AGENT_REFUND_START_ENABLED=false
# 与 INTERNAL_JWT_SECRET 分离；任何写工具开启时必须至少 32 bytes。
AGENT_CONFIRMATION_SECRET=
AGENT_CONFIRMATION_ISSUER=agentscope-platform
AGENT_CONFIRMATION_AUDIENCE=agentscope-tool-execution
AGENT_CONFIRMATION_KEY_ID=agentscope-confirmation-v1
AGENT_CONFIRMATION_TTL_SECONDS=120
AGENT_CONFIRMATION_CLOCK_SKEW_SECONDS=5
AGENT_CONFIRMATION_MAX_GRANTS=8
# local/test 可用 memory；production 开启写工具时强制 redis。
AGENT_CONFIRMATION_REPLAY_STORE=memory
AGENT_CONFIRMATION_REDIS_URL=
AGENT_CONFIRMATION_REDIS_NAMESPACE=agentscope:tool-confirmation
# 外部 MCP/Browser/Code provider 的独立短时服务令牌；不得复用 caller/internal/confirmation key。
AGENT_DOWNSTREAM_JWT_HEADER=X-Agent-Service-Token
AGENT_DOWNSTREAM_JWT_SECRET=
AGENT_DOWNSTREAM_JWT_ISSUER=agentscope-platform
AGENT_DOWNSTREAM_JWT_SUBJECT=agentscope-orchestrator
AGENT_DOWNSTREAM_JWT_KEY_ID=agentscope-downstream-v1
AGENT_DOWNSTREAM_JWT_TTL_SECONDS=60
AGENT_MCP_AUDIENCE=mcp-provider
AGENT_BROWSER_AUDIENCE=browser-sandbox
AGENT_CODE_AUDIENCE=code-sandbox
# 标准 Streamable HTTP MCP；只注册 JSON allowlist，禁止 stdio 与动态未知工具。
AGENT_MCP_ENABLED=false
AGENT_MCP_URL=
AGENT_MCP_TOOLS_JSON=[]
AGENT_MCP_MAX_ARGUMENTS_BYTES=65536
AGENT_MCP_MAX_RESULT_CHARS=32768
# 浏览器和代码只能调用独立远端 sandbox；本进程没有 Playwright/子进程 fallback。
AGENT_BROWSER_ENABLED=false
AGENT_BROWSER_SANDBOX_URL=
AGENT_BROWSER_ALLOWED_HOSTS_JSON=[]
AGENT_BROWSER_TIMEOUT_SECONDS=15
AGENT_BROWSER_MAX_INPUT_CHARS=4000
AGENT_BROWSER_MAX_OUTPUT_CHARS=20000
AGENT_CODE_EXEC_ENABLED=false
AGENT_CODE_SANDBOX_URL=
AGENT_CODE_TIMEOUT_SECONDS=3
AGENT_CODE_MAX_SOURCE_CHARS=4000
AGENT_CODE_MAX_OUTPUT_CHARS=2000
AGENT_CODE_MAX_MEMORY_MB=64
AGENT_CODE_MAX_PROCESSES=4
ORDER_BASE_URL=http://localhost:8093
HTTP_CONNECT_TIMEOUT_SECONDS=1
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY_SECONDS=30
HTTP_DEPENDENCY_MAX_CONCURRENT=32
HTTP_CIRCUIT_FAILURE_THRESHOLD=5
HTTP_CIRCUIT_RECOVERY_SECONDS=15
# readiness 的所有启用依赖并发探测；单个依赖不得拖慢超过该上限。
READINESS_PROBE_TIMEOUT_SECONDS=2
# 仅用于估算 Prometheus 成本；按实际模型价格配置，0 表示不估算该方向成本。
AGENT_INPUT_COST_USD_PER_MILLION_TOKENS=0
AGENT_OUTPUT_COST_USD_PER_MILLION_TOKENS=0

# Phase 3 异步 Agent：默认关闭；中央 async-task-service 是唯一任务/事件权威。
ASYNC_TASK_ENABLED=false
ASYNC_TASK_BASE_URL=http://localhost:8086
ASYNC_TASK_WORKER_ID=
ASYNC_TASK_WORKER_JWT_HEADER=X-Async-Worker-Token
ASYNC_TASK_WORKER_JWT_SECRET=
ASYNC_TASK_WORKER_JWT_ISSUER=platform-services
ASYNC_TASK_WORKER_JWT_AUDIENCE=async-task-worker
ASYNC_TASK_WORKER_JWT_KEY_ID=async-task-worker-v1
ASYNC_TASK_WORKER_JWT_TTL_SECONDS=60
ASYNC_TASK_LEASE_SECONDS=60
ASYNC_TASK_HEARTBEAT_SECONDS=15
ASYNC_TASK_MAX_CONCURRENT=8
ASYNC_TASK_MAX_INFLIGHT=100
ASYNC_TASK_MAX_RUNTIME_SECONDS=240
ASYNC_TASK_DRAIN_TIMEOUT_SECONDS=30
AGENTSCOPE_STOP_GRACE_PERIOD=45s
ASYNC_TASK_TOKEN_SAFETY_SECONDS=20
ASYNC_TASK_CONNECT_TIMEOUT_SECONDS=1
ASYNC_TASK_REQUEST_TIMEOUT_SECONDS=5
ASYNC_TASK_STREAM_IDLE_TIMEOUT_SECONDS=30
ASYNC_TASK_EVENT_MAX_BYTES=262144
ASYNC_TASK_PROGRESS_ENABLED=true

OTEL_ENABLED=false
OTEL_SERVICE_NAME=agentscope-orchestrator
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
