APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8085
APP_LOG_LEVEL=INFO

# AgentScope 2.0 继续经 LiteLLM 使用 OpenAI-compatible API。
GATEWAY_BASE_URL=http://localhost:4000/v1
GATEWAY_API_KEY=replace-with-local-litellm-key
GATEWAY_MODEL=chat-default
GATEWAY_TEMPERATURE=0.2
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=0
AGENT_TIMEOUT_SECONDS=0
AGENT_MAX_REPEATS=3
AGENT_LOOP_WINDOW=6
AGENT_RAG_TOP_K=5
AGENT_RAG_MIN_SCORE=0
AGENT_RAG_CATEGORY=
# 候选灰度入口默认关闭；仅在 edge/facade 路由演练时显式开启。
AGENT_V2_ENABLED=false
# Phase 2 DAG 同步编排限制。
AGENT_DAG_MAX_TASKS=6
AGENT_DAG_MAX_PARALLEL_WORKERS=8
# 与旧服务部署默认一致；可作为独立回滚开关关闭。
AGENT_DAG_REPLAN_ENABLED=true
AGENT_DAG_REPLAN_MAX_REPLANS=1
AGENT_DAG_REPLAN_THRESHOLD=0.75
AGENT_DAG_REPLAN_WEIGHT_CORRECTNESS=0.5
AGENT_DAG_REPLAN_WEIGHT_COMPLETENESS=0.35
AGENT_DAG_REPLAN_WEIGHT_CLARITY=0.15
# Planner 使用确定性 JSON 输出；默认不自动重试，避免隐藏的模型调用放大。
AGENT_PLANNER_MAX_TOKENS=1200
AGENT_PLANNER_TIMEOUT_SECONDS=30
AGENT_PLANNER_MAX_RETRIES=0
AGENT_CHAINING_STEPS_JSON=[{"name":"translate","instruction":"把输入内容翻译成英文，只输出译文，不要额外解释","gateMinLength":10},{"name":"summarize","instruction":"用一句中文概括上一步英文内容的要点","gateMinLength":8}]
AGENT_VOTING_N=3
AGENT_VOTING_MAX_CANDIDATES=10
AGENT_VOTING_STRATEGY=majority
AGENT_VOTING_MIN_AGREEMENT=0.5
AGENT_SIBLING_MAX_PARALLEL_WORKERS=10
AGENT_REFLEXION_THRESHOLD=0.75
AGENT_REFLEXION_MAX_ATTEMPTS=2
AGENT_REFLEXION_WEIGHT_CORRECTNESS=0.4
AGENT_REFLEXION_WEIGHT_COMPLETENESS=0.4
AGENT_REFLEXION_WEIGHT_CLARITY=0.2

# 与 langchain4j-platform 的 platform-security 对齐。
INTERNAL_AUTH_REQUIRED=true
INTERNAL_JWT_HEADER=X-Internal-Token
INTERNAL_JWT_ALGORITHM=HS256
INTERNAL_JWT_SECRET=dev-only-internal-secret-change-me-please-32b
# RS256 验签时使用 PEM 内容或文件路径，二选一；HS256 时留空。
INTERNAL_JWT_PUBLIC_KEY=
INTERNAL_JWT_PUBLIC_KEY_FILE=

KNOWLEDGE_BASE_URL=http://localhost:8084
ANALYTICS_BASE_URL=http://localhost:8083
# Slice 5：仅双跑候选 SQL planner；主响应仍来自 Java 旧 NL2SQL 路径。
ANALYTICS_EXTERNAL_PLANNER_SHADOW_ENABLED=false
ANALYTICS_EXTERNAL_PLANNER_MAX_TABLES=20
WORKFLOW_BASE_URL=http://localhost:8082
ORDER_BASE_URL=http://localhost:8093
HTTP_CONNECT_TIMEOUT_SECONDS=1
HTTP_READ_TIMEOUT_SECONDS=10

# Phase 3 异步 Agent：默认关闭；中央 async-task-service 是唯一任务/事件权威。
ASYNC_TASK_ENABLED=false
ASYNC_TASK_BASE_URL=http://localhost:8086
ASYNC_TASK_WORKER_ID=
ASYNC_TASK_LEASE_SECONDS=60
ASYNC_TASK_HEARTBEAT_SECONDS=15
ASYNC_TASK_MAX_CONCURRENT=8
ASYNC_TASK_MAX_INFLIGHT=100
ASYNC_TASK_MAX_RUNTIME_SECONDS=240
ASYNC_TASK_TOKEN_SAFETY_SECONDS=20
ASYNC_TASK_CONNECT_TIMEOUT_SECONDS=1
ASYNC_TASK_REQUEST_TIMEOUT_SECONDS=5
ASYNC_TASK_EVENT_MAX_BYTES=262144
ASYNC_TASK_PROGRESS_ENABLED=true

OTEL_ENABLED=false
OTEL_SERVICE_NAME=agentscope-orchestrator
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
