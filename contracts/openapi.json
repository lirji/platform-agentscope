{
  "components": {
    "schemas": {
      "AgentRunReply": {
        "properties": {
          "depth": {
            "default": 0,
            "title": "Depth",
            "type": "integer"
          },
          "finalAnswer": {
            "title": "Finalanswer",
            "type": "string"
          },
          "goal": {
            "title": "Goal",
            "type": "string"
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/AgentStep"
            },
            "title": "Steps",
            "type": "array"
          },
          "stopReason": {
            "title": "Stopreason",
            "type": "string"
          },
          "tenantId": {
            "title": "Tenantid",
            "type": "string"
          }
        },
        "required": [
          "goal",
          "finalAnswer",
          "stopReason",
          "tenantId"
        ],
        "title": "AgentRunReply",
        "type": "object"
      },
      "AgentRunRequest": {
        "additionalProperties": false,
        "properties": {
          "goal": {
            "maxLength": 20000,
            "minLength": 1,
            "title": "Goal",
            "type": "string"
          },
          "webhookUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Webhookurl"
          }
        },
        "required": [
          "goal"
        ],
        "title": "AgentRunRequest",
        "type": "object"
      },
      "AgentStep": {
        "properties": {
          "action": {
            "default": "",
            "title": "Action",
            "type": "string"
          },
          "actionInput": {
            "default": "",
            "title": "Actioninput",
            "type": "string"
          },
          "n": {
            "title": "N",
            "type": "integer"
          },
          "observation": {
            "default": "",
            "title": "Observation",
            "type": "string"
          },
          "thought": {
            "default": "",
            "title": "Thought",
            "type": "string"
          }
        },
        "required": [
          "n"
        ],
        "title": "AgentStep",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Incremental AgentScope 2.0 replacement for langchain4j-platform agent-service.",
    "title": "AgentScope Platform",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/agent/run": {
      "post": {
        "operationId": "run_agent_agent_run_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Agent",
        "tags": [
          "agent"
        ]
      }
    },
